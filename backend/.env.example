# =============================================================================
# Tableau MCP AI Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🔧 Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development                    # development, staging, production
DEBUG=true
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# Generate a secure key for the application (required)
# Run: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-me-generate-with-openssl

# -----------------------------------------------------------------------------
# 🤖 OpenAI Configuration (Required for AI features)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview       # Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1                 # Lower = more deterministic (0.0 - 1.0)

# -----------------------------------------------------------------------------
# 📊 Tableau Cloud Configuration (Required)
# -----------------------------------------------------------------------------
# Your Tableau Cloud server URL (e.g., https://prod-useast-c.online.tableau.com)
TABLEAU_SERVER=https://your-pod.online.tableau.com

# Your site name (found in URL: https://your-pod.online.tableau.com/#/site/YOUR-SITE-NAME)
TABLEAU_SITE_NAME=your-site-name

# -----------------------------------------------------------------------------
# 🔐 Tableau Authentication - Choose ONE method below
# -----------------------------------------------------------------------------

# ═══════════════════════════════════════════════════════════════════════════
# METHOD 1: Connected Apps (JWT) - RECOMMENDED for production
# ═══════════════════════════════════════════════════════════════════════════
# Create a Connected App in Tableau Cloud:
#   Settings > Connected Apps > Create a new Connected App
#   - Enable the app
#   - Generate a secret
# 
TABLEAU_AUTH_METHOD=connected_app      # Use 'connected_app' or 'pat'

# Connected App credentials (from Tableau Admin > Connected Apps)
TABLEAU_CONNECTED_APP_CLIENT_ID=your-client-id-here
TABLEAU_CONNECTED_APP_SECRET_ID=your-secret-id-here
TABLEAU_CONNECTED_APP_SECRET_VALUE=your-secret-value-here

# The Tableau username to impersonate (must have access to datasources)
TABLEAU_USERNAME=your-tableau-username@example.com

# ═══════════════════════════════════════════════════════════════════════════
# METHOD 2: Personal Access Token (PAT) - Simpler, good for development
# ═══════════════════════════════════════════════════════════════════════════
# Create a PAT in Tableau Cloud:
#   My Account Settings > Personal Access Tokens > Create a new token
#
# TABLEAU_AUTH_METHOD=pat
# TABLEAU_PAT_NAME=your-pat-name
# TABLEAU_PAT_VALUE=your-pat-value

# -----------------------------------------------------------------------------
# 🗄️ PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost                # Use 'postgres' when running with Docker
POSTGRES_PORT=5432
POSTGRES_USER=tableau_mcp
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=tableau_mcp_db

# -----------------------------------------------------------------------------
# 🌐 Backend API Configuration
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# -----------------------------------------------------------------------------
# 🔗 MCP Server Configuration
# -----------------------------------------------------------------------------
# Local development: http://localhost:3927
# Docker Compose: http://mcp:3927
MCP_SERVER_URL=http://localhost:3927
MCP_REQUEST_TIMEOUT=60

# -----------------------------------------------------------------------------
# 📈 Activity Tracking & Analytics
# -----------------------------------------------------------------------------
ENABLE_ACTIVITY_TRACKING=true
ACTIVITY_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# 💾 Cache Configuration
# -----------------------------------------------------------------------------
CACHE_TTL=300                          # Cache TTL in seconds
CACHE_MAX_SIZE=1000                    # Max items in cache
