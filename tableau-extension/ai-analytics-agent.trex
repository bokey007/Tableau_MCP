<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.company.ai-analytics-agent" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>AI-powered natural language analytics assistant for Tableau dashboards</description>
    <author name="GenAI Team" email="genai@company.com" website="https://company.com"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <!-- UPDATE THIS URL to your deployed extension location -->
      <url>https://your-ares-domain.company.com/extension/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">AI Analytics Agent</text>
    </resource>
  </resources>
</manifest>
