# =============================================================================
# Tableau MCP AI Agent - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.template .env
# Then run: docker compose up --build
# =============================================================================

# -----------------------------------------------------------------------------
# 🤖 LLM Configuration (Required - Choose ONE provider)
# -----------------------------------------------------------------------------
# LLM_PROVIDER: "openai" (default) or "azure"
LLM_PROVIDER=openai

# --- Option 1: OpenAI ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o                    # Options: gpt-4o, gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo

# --- Option 2: Azure OpenAI ---
# Set LLM_PROVIDER=azure and fill in these values:
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -----------------------------------------------------------------------------
# 📊 Tableau Cloud (Required)
# -----------------------------------------------------------------------------
# Your Tableau Cloud URL (e.g. https://prod-useast-c.online.tableau.com)
TABLEAU_SERVER=https://your-pod.online.tableau.com

# Your site name from the URL (https://.../#/site/YOUR-SITE-NAME)
TABLEAU_SITE_NAME=your-site-name

# -----------------------------------------------------------------------------
# 🔐 Tableau Connected Apps - Direct Trust (Required)
# -----------------------------------------------------------------------------
# Create a Connected App in Tableau Cloud:
#   Settings > Connected Apps > New Connected App
#   - Choose "Direct Trust"
#   - Enable the app
#   - Generate a secret
#
# For detailed instructions, see:
# https://help.tableau.com/current/online/en-us/connected_apps_direct.htm

TABLEAU_CONNECTED_APP_CLIENT_ID=your-connected-app-client-id
TABLEAU_CONNECTED_APP_SECRET_ID=your-secret-id
TABLEAU_CONNECTED_APP_SECRET_VALUE="your-secret-value"

# Your Tableau username (email) - used as JWT_SUB_CLAIM
TABLEAU_USERNAME=your-email@company.com

# -----------------------------------------------------------------------------
# 🗄️ Database (Required)
# -----------------------------------------------------------------------------
POSTGRES_USER=tableau_mcp
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=tableau_mcp_db

# -----------------------------------------------------------------------------
# 🔧 Application Security (Required)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-a-64-character-hex-string-using-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# 🌐 Optional Settings
# -----------------------------------------------------------------------------
# Backend configuration
# BACKEND_PORT=8000
# LOG_LEVEL=INFO

# MCP Server configuration
# MCP_REQUEST_TIMEOUT=180

# Frontend configuration
# FRONTEND_PORT=8501
